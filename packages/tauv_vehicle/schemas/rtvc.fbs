namespace TAUV;

struct Vec3 {
  x:float32;
  y:float32;
  z:float32;
}

struct Quat {
  w:float32;
  x:float32;
  y:float32;
  z:float32;
}

table Eth100HzMsg {
    imu_data:[XsensIMUFrame];
}

struct XsensIMUFrame {
  sample_time:uint64;
  orientation:Quat;
  rate_of_turn:Vec3;
  free_acceleration:Vec3;
}

table ThrusterCommand {
  rpm:[float32];
  enabled:[bool];
}
