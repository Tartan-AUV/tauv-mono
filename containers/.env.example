# Copy to .env (gitignored). Everything here is optional.
# Compose reads .env automatically when you run `docker compose` in this directory.
#
# Note: UID/GID for the image build are NOT set here. `just build` derives them from
# `id -u` / `id -g`. If you run bake by hand, export HOST_UID and HOST_GID yourself.

# Image tag to run: `latest`, or a git SHA to pin a known-good build
TAG=latest

# Orin only: where recorded data lives on the vehicle (mounted at /data)
# DATA_DIR=/home/tauv/data

# Which compose files to load. Uncomment to enable the NVIDIA override and/or your
# personal override. Separator is ':' on Linux/macOS.
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml:compose.override.yaml
