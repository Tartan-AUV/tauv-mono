<?xml version="1.0"?>
<package format="3">
  <name>tauv_mission</name>
  <version>0.0.0</version>
  <description>Mission-level tools and teleoperation CLI for TartanAUV vehicles.</description>
  <maintainer email="gryabtse@andrew.cmu.edu">gleb</maintainer>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tauv_msgs</exec_depend>
  <!-- Readline comes with Python on POSIX; no explicit ROS dependency needed -->

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
