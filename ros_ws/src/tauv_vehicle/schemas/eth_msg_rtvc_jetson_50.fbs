namespace TAUV_FB;

table Eth50HzESCMsg {
    esc_data:[ESCFrame];
}

table ESCFrame {
    id:uint8;               // ESC identifier
    rpm:int32;              // Rotations per minute
    voltage:float;          // Voltage in volts
    current:float;          // Current in amps
    temperature:float;      // Temperature in Celsius
    fault_code:uint8;       // ESC fault code, if any
}

root_type Eth50HzESCMsg;
