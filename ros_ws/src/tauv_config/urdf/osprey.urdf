    <parent link="os_arm_tube"/>
    <child link="os/arm/intake"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- Frame os/arm/thruster (dummy link + fixed joint) -->
  <link name="os/arm/thruster">
    <origin xyz="0 0 0" rpy="0 -0 0"/>
