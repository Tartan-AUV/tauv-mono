    <child link="os_arm_tube"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-3.141592653589793" upper="3.141592653589793"/>
    <mimic joint="os/arm/base" multiplier="-0.6666666666666666"/>
